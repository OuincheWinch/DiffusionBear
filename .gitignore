# -*- mode: gitignore; encoding: utf-8 -*-

# The whole runtime data directory. The entries below it used to be listed one by one,
# which meant anything new that landed there showed up as untracked -- that is how
# queue_recovery.json.invalid.<ts> became a git candidate, and a stray token file would
# have done the same. test_repo_security only audits `git ls-files`, so an untracked
# secret there is invisible to it. Nothing in backend/data belongs in version control.
backend/data/

# ---- Secrets & local credentials (NEVER commit) ----
backend/data/civitai_token.txt
backend/data/hf_token.txt
backend/data/*.token
backend/data/*token*.txt
**/hf_token.txt
session.txt


# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
venv-coreml/
venv-sdxl/
venv-fibo/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/.vite/

# ---- Generated content & runtime state ----
backend/data/generated/
backend/data/uploads/
backend/data/lora_files/
backend/data/models/
backend/data/SDXL/
backend/data/loras.json
backend/data/settings.json
backend/data/pending_queue.json
backend/data/queue_recovery.json
backend/data/tmp*.download
backend/data/.tmp/
backend/data/settings.smoketest.json
*.raw.png
*.download

